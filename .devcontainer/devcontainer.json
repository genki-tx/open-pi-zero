{
    "name": "open-pi-zero",
    "build": {
      "context": "..",
      "dockerfile": "../Dockerfile"
    },
    "runArgs": [
      "--privileged",
      "--gpus=all",
      "--net=host",
      "--env=DISPLAY=unix${localEnv:DISPLAY}",
      "--env=VLA_DATA_DIR=/root/workspace/dataset/vla_data",
      "--env=VLA_LOG_DIR=/root/workspace/dataset/vla_log",
      "--env=TRANSFORMERS_CACHE=/root/workspace/dataset/hf_models",
      "--env=VLA_WANDB_ENTITY=${localEnv:WANDB_ENTITY}",
      "--env=WANDB_API_KEY=${localEnv:WANDB_API_KEY}",
      "--env=NVIDIA_DRIVER_CAPABILITIES=all",
      "--env=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True", // Enable this line if your GPU memory size is not enough (e.g. 8GB)
      "--env=MS2_REAL2SIM_ASSET_DIR=/root/workspace/SimplerEnv/ManiSkill2_real2sim/data", // to use SimplerEnv
      "--env=VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json" // to use SimplerEnv
    ],
    "mounts": [
      "source=${localEnv:HOME}/dataset,target=/root/workspace/dataset,type=bind",
      "source=${localWorkspaceFolder},target=/root/workspace/open-pi-zero,type=bind",
      "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
    ],
    "workspaceFolder": "/root/workspace/open-pi-zero",
    "customizations": {
      "vscode": {
        "extensions": [
          "ms-python.python",
          "ms-azuretools.vscode-docker"
        ],
        "settings": {
          "python.defaultInterpreterPath": "/root/workspace/.venv/bin/python"
        }
      }
    },
    "postCreateCommand": ""
}
